# Delulu Police Environment Configuration

# Google Gemini API Key (Server-side only, never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (e.g. gemini-1.5-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional Rate Limiter setting (requests per minute per IP, default is 8)
RATE_LIMIT_PER_MIN=8

